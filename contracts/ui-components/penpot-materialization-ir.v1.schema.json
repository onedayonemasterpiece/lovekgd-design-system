{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.dev/schemas/penpot-materialization-ir.v1.schema.json",
  "title": "Bounded Penpot materialization IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ir_id", "component_id", "contract_sha256", "baseline_revision", "operations", "propagation_audit_required", "idempotency"],
  "properties": {
    "schema_version": {"const": "penpot-materialization-ir.v1"},
    "ir_id": {"type": "string", "minLength": 3},
    "component_id": {"type": "string", "minLength": 3},
    "contract_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "baseline_revision": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation_id", "type", "owner_level", "target_id", "changes", "allowed_content_fields", "expected_propagation_consumers"],
        "properties": {
          "operation_id": {"type": "string"},
          "type": {"enum": ["master-update", "instance-content-override", "review-instance-create", "review-instance-update", "retire-binding"]},
          "owner_level": {"enum": ["foundation", "child-master", "parent-master", "content-instance", "review-wrapper", "binding"]},
          "target_id": {"type": ["string", "null"]},
          "changes": {"type": "object"},
          "allowed_content_fields": {"type": "array", "items": {"type": "string"}},
          "expected_propagation_consumers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "propagation_audit_required": {"const": true},
    "idempotency": {"type": "object", "required": ["stable_ids", "second_run_created", "second_run_unexpected_updates"]}
  }
}
