{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.dev/schemas/component-contract.v1.schema.json",
  "title": "UI component contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_id", "contract_version", "contract_sha256", "decision_lifecycle", "reference_authority", "source", "penpot", "variant_axes", "semantic_children", "content_slots", "forbidden_instance_overrides", "known_materialization_gaps", "supersedes"],
  "properties": {
    "schema_version": {"const": "ui-component-contract.v1"},
    "component_id": {"type": "string", "minLength": 3},
    "contract_version": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "decision_lifecycle": {"enum": ["reconstructed", "owner-corrected-candidate", "owner-accepted-candidate", "promoted"]},
    "reference_authority": {"enum": ["astro-reference", "penpot-candidate-reference", "promoted-contract-reference"]},
    "source": {"type": "object", "required": ["repository", "repository_sha", "paths"]},
    "penpot": {"type": "object", "required": ["file_id", "page_id", "variant_container_id", "active_variant_count"]},
    "variant_axes": {"type": "object", "minProperties": 1},
    "semantic_children": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["component_id", "owner_level", "required_linkage"]}},
    "content_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_instance_overrides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "known_materialization_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "scope", "description", "comparison_disposition"],
        "properties": {
          "gap_id": {"type": "string", "minLength": 3},
          "scope": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "comparison_disposition": {"enum": ["fail", "blocked", "not-materialized"]}
        }
      }
    },
    "supersedes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
