{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kenigevents.w0-issued-w3-penpot-run-capsule.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "run_id",
    "generation",
    "file_id",
    "page_id",
    "issued_at",
    "expires_at",
    "nonce",
    "cancelled",
    "accepted_executor",
    "accepted_bundle",
    "ticket_root_sha256",
    "tickets",
    "w0_binding",
    "rollback_ticket_root_sha256",
    "rollback_tickets"
  ],
  "properties": {
    "schema": {
      "const": "kenigevents.w0-issued-w3-penpot-run-capsule.v1"
    },
    "owner": {
      "const": "W3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "file_id": {
      "type": "string",
      "format": "uuid"
    },
    "page_id": {
      "type": "string",
      "format": "uuid"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "cancelled": {
      "const": false
    },
    "accepted_executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_identity",
        "payload_sha256",
        "artifact_raw_sha256",
        "commit_sha"
      ],
      "properties": {
        "semantic_identity": {
          "const": "kenigevents.free-collection.ordinary-penpot-visual-executor"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha"
        },
        "artifact_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "accepted_bundle": {
      "type": "object",
      "required": [
        "id",
        "content_sha256",
        "authorization"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha"
        },
        "authorization": {
          "const": "W0_ACCEPTED_FOR_W3_EXECUTION"
        }
      }
    },
    "compatibility_probe_receipt_sha256": {
      "$ref": "#/$defs/sha"
    },
    "ticket_root_sha256": {
      "$ref": "#/$defs/sha"
    },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "w0-penpot-mutation-ticket.v1.schema.json"
      }
    },
    "w0_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "body_sha256",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "$ref": "#/$defs/sha"
        },
        "signature": {
          "type": "string",
          "pattern": "^W0:.+"
        }
      }
    },
    "rollback_ticket_root_sha256": {
      "$ref": "#/$defs/sha"
    },
    "rollback_tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "w0-penpot-mutation-ticket.v1.schema.json"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
