  "task_output_contract": [
    "task_classification_and_authority_boundary",
    "exact_sources_and_evidence_states",
    "current_truth_and_as_is_census",
    "gaps_contradictions_unknowns",
    "resource_kind_and_boundary_decision",
    "proposed_contract_delta",
    "foundation_content_token_responsive_dependencies",
    "files_and_surfaces_to_update",
    "penpot_plan_or_not_authorized",
    "code_docs_tests_fixtures_plan",
    "validation_results_and_evidence_refs",
    "migration_compatibility_rollback",
    "owner_decisions",
    "current_and_next_adjacent_lifecycle_gate",
    "receipts_and_manifests"
  ],
  "workstreams": [
    {
      "id": "W0",
      "name": "Governance and evidence",
      "gate": "GOVERNANCE_REVIEWED",
      "authority_change": false,
      "deliverables": [
        "source/evidence register",
        "external-reference availability ledger",
        "resource-kind definitions",
        "decision record template",
        "owner/reviewer roles",
        "review severity and closure protocol",
        "compatibility and supersession policy"
      ]
    },
    {
      "id": "W1",
      "name": "SoT registry and machine schemas",
      "gate": "REGISTRY_SCHEMA_ACCEPTED",
      "authority_change": false,
      "deliverables": [
        "component/pattern/archetype metadata schemas",
        "stable binding tuples",
        "external-reference evidence schema",
        "foundation-domain contract schema",
        "token registry and dependency schema",
        "content and terminology registry schema",
        "brand/media/responsive registries",
        "fixture and viewport registries",
        "binding registry",
        "canonical naming and display-alias schema",
        "variant-version prohibition validation",
        "valid-combination validation",
        "catalog rendering contract"
      ]
    },
    {
      "id": "W2",
      "name": "Foundations and tokens",
      "gate": "PILOT_FOUNDATIONS_READY",
      "authority_change": false,
      "scope_rule": "pilot-consumed foundations only",
      "deliverables": [
        "pilot-consumed foundation-domain inventory",
        "content and terminology registry",
        "brand-asset registry",
        "semantic color and mode model",
        "typography and iconography contracts",
        "media policy registry",
        "responsive breakpoint/container/grid registry",
        "spacing/radius/opacity/elevation/motion foundations",
        "accessibility foundation requirements",
        "consumer mappings and exact foundation-version bindings",
        "Penpot/code exports and drift validation"
      ]
    },
    {
      "id": "W3",
      "name": "Component dossier pilot",
      "gate": "COMPONENT_OWNER_REVIEW_COMPLETE",
      "authority_change": false,
      "pilot_selection_rule": "highest exact evidence/readiness score, not visual simplicity"
    },
    {
      "id": "W4",
      "name": "Pattern/block layer",
      "gate": "PATTERN_BOUNDARY_REVIEWED",
      "authority_change": false
    },
    {
      "id": "W5",
      "name": "Page archetype candidate",
      "gate": "ARCHETYPE_OWNER_REVIEW_COMPLETE",
      "authority_change": false
    },
    {
      "id": "W6",
      "name": "Penpot owner-review operations",
      "gate": "REVIEW_WORKFLOW_VALIDATED",
      "authority_change": false
    },
    {
      "id": "W7",
      "name": "Conformance, release and migration",
      "gate": "NORMATIVE_PROMOTION_GATE",
      "authority_change": "only_through_existing_FAMILY_AND_ARCHETYPE_PROMOTION"
    }
  ],
  "phases": [
    {
      "order": 0,
      "id": "owner_operating_model_decision",
      "implementation_allowed": false
    },
    {
      "order": 1,
      "id": "machine_contracts",
      "implementation_scope": "schemas_and_validators_only"
