      "required_for_component_refs": true
    },
    {
      "id": "component",
      "owner": "component_contract"
    },
    {
      "id": "pattern_or_archetype",
      "creation_rule": "only_for_proven_repeated_composition_invariant"
    },
    {
      "id": "theme_or_product_alias",
      "may_change_semantics": false
    }
  ],
  "token_dependency_requirements": [
    "stable_collection_id",
    "owner",
