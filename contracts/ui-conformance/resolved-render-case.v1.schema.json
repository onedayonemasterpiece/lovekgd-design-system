{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.dev/schemas/resolved-render-case.v1.schema.json",
  "title": "Hash-bound resolved UI render case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "component_id", "contract_version", "contract_sha256", "authority_mode", "conformance_profile", "state_key", "viewport_id", "container_geometry", "event_fixture_id", "event_payload_sha256", "event_fixture_path", "corpus_id", "corpus_sha256", "source_database_snapshot_fingerprint", "reference_clock", "asset_refs", "asset_manifest_sha256", "resolved_content", "resolved_media", "resolved_visibility", "resolved_nested_components", "resolved_props", "expected_candidate_deltas", "resolved_render_case_sha256"],
  "properties": {
    "schema_version": {"const": "resolved-render-case.v1"},
    "case_id": {"type": "string", "minLength": 3},
    "component_id": {"const": "event.card"},
    "contract_version": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "authority_mode": {"enum": ["astro-reference", "penpot-candidate-reference", "promoted-contract-reference"]},
    "conformance_profile": {"enum": ["pixel-strict", "state-sampled", "structure-and-behavior", "nonvisual"]},
    "state_key": {"type": "string", "minLength": 1},
    "viewport_id": {"type": "string", "minLength": 1},
    "container_geometry": {"type": "object", "required": ["viewport_width", "viewport_height", "container_width", "device_scale_factor"]},
    "event_fixture_id": {"type": "string", "pattern": "^event\\.real\\.[0-9]+$"},
    "event_payload_sha256": {"$ref": "#/$defs/sha256"},
    "event_fixture_path": {"type": "string", "pattern": "^events/event\\.real\\.[0-9]+\\.json$"},
    "corpus_id": {"type": "string", "pattern": "^ui-reference-events\\.v[0-9]+$"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "source_database_snapshot_fingerprint": {"$ref": "#/$defs/sha256"},
    "reference_clock": {"type":"object","required":["current_date","reference_iso","timezone"],"properties":{"current_date":{"type":"string"},"reference_iso":{"type":"string"},"timezone":{"const":"Europe/Kaliningrad"}}},
    "asset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "asset_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^asset\\.sha256\\.[a-f0-9]{64}$"}},
    "resolved_content": {"type": "object", "required": ["title", "date", "time", "place", "admission", "counts", "labels"]},
    "resolved_media": {"type": ["object", "null"]},
    "resolved_visibility": {"type": "object"},
    "resolved_nested_components": {"type": "array", "uniqueItems": true, "items": {"type": "object", "required": ["component_id", "role"]}},
    "resolved_props": {"type": "object"},
    "expected_candidate_deltas": {"type": "array"},
    "resolved_render_case_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
