{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kenigevents.resolved-render-case.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "control_generation", "authority", "payload", "content_sha256"],
  "properties": {
    "schema": {"const": "kenigevents.resolved-render-case.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "control_generation": {"const": 4},
    "authority": {"type": "object", "required": ["input_bindings", "generator"]},
    "payload": {"type": "object", "required": ["case_kind", "scenario", "fixture_order", "groups", "fixtures", "assets", "geometry", "crop"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
