{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.dev/schemas/ui-surface-expectations.v1.schema.json",
  "title": "Frozen surface-placement expectations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "reference_clock", "surface_classes", "scenarios"],
  "properties": {
    "schema_version": {"const": "ui-surface-expectations.v1"},
    "corpus_id": {"pattern": "^ui-reference-events\\.v[0-9]+$"},
    "reference_clock": {"type": "object", "required": ["current_date", "reference_iso", "timezone"]},
    "surface_classes": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"enum": ["event-detail", "date-listing", "today", "tomorrow", "weekend", "home", "popular", "unusual", "search", "favorites", "personal-feed", "related"]}},
    "scenarios": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "fixture_id", "surface_id", "route", "context", "expected_presence", "expected_component", "expected_state_key", "expected_order_or_group", "reason"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "fixture_id": {"type": "string", "pattern": "^event\\.real\\.[0-9]+$"},
          "surface_id": {"type": "string", "enum": ["event-detail", "date-listing", "today", "tomorrow", "weekend", "home", "popular", "unusual", "search", "favorites", "personal-feed", "related"]},
          "route": {"type": "string", "pattern": "^/"},
          "context": {"type": "object"},
          "expected_presence": {"enum": ["present", "absent", "not_implemented", "blocked"]},
          "expected_component": {"type": ["string", "null"]},
          "expected_state_key": {"type": ["string", "null"]},
          "expected_order_or_group": {},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
