{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.dev/schemas/resolved-render-case.v2.schema.json",
  "title": "Hash-bound resolved UI render case v2 with consumer layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "component_id",
    "contract_version",
    "contract_sha256",
    "authority_mode",
    "conformance_profile",
    "state_key",
    "viewport_id",
    "container_geometry",
    "event_fixture_id",
    "event_payload_sha256",
    "event_fixture_path",
    "corpus_id",
    "corpus_sha256",
    "source_database_snapshot_fingerprint",
    "reference_clock",
    "asset_refs",
    "asset_manifest_sha256",
    "resolved_content",
    "resolved_media",
    "resolved_visibility",
    "resolved_nested_components",
    "resolved_props",
    "expected_candidate_deltas",
    "resolved_render_case_sha256",
    "consumer_layout_resolution",
    "consumer_layout_resolution_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "resolved-render-case.v2"
    },
    "case_id": {
      "type": "string",
      "minLength": 3
    },
    "component_id": {
      "const": "event.card"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_mode": {
      "enum": [
        "astro-reference",
        "penpot-candidate-reference",
        "promoted-contract-reference"
      ]
    },
    "conformance_profile": {
      "enum": [
        "pixel-strict",
        "state-sampled",
        "structure-and-behavior",
        "nonvisual"
      ]
    },
    "state_key": {
      "type": "string",
      "minLength": 1
    },
    "viewport_id": {
      "type": "string",
      "minLength": 1
    },
    "container_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport_width",
        "viewport_height",
        "container_width",
        "used_card_width",
        "device_scale_factor"
      ],
      "properties": {
        "viewport_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viewport_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "container_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "used_card_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "device_scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        }
      }
    },
    "event_fixture_id": {
      "type": "string",
      "pattern": "^event\\.real\\.[0-9]+$"
    },
    "event_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "event_fixture_path": {
      "type": "string",
      "pattern": "^events/event\\.real\\.[0-9]+\\.json$"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^ui-reference-events\\.v[0-9]+$"
    },
    "corpus_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_database_snapshot_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "reference_clock": {
      "type": "object",
      "required": [
        "current_date",
        "reference_iso",
        "timezone"
      ],
      "properties": {
        "current_date": {
          "type": "string"
        },
        "reference_iso": {
          "type": "string"
        },
        "timezone": {
          "const": "Europe/Kaliningrad"
        }
      }
    },
    "asset_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "asset_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^asset\\.sha256\\.[a-f0-9]{64}$"
      }
    },
    "resolved_content": {
      "type": "object",
      "required": [
        "title",
        "date",
        "time",
        "place",
        "admission",
        "counts",
        "labels"
      ]
    },
    "resolved_media": {
      "type": [
        "object",
        "null"
      ]
    },
    "resolved_visibility": {
      "type": "object"
    },
    "resolved_nested_components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "role"
        ]
      }
    },
    "resolved_props": {
      "type": "object"
    },
    "expected_candidate_deltas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidateDelta"
      }
    },
    "resolved_render_case_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "consumer_layout_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "resolution_id",
        "surface",
        "viewport",
        "container",
        "grid",
        "packing",
        "row_policy",
        "used_card_geometry",
        "media_available_box",
        "framing_rule",
        "candidate_deltas",
        "derivation"
      ],
      "properties": {
        "schema_version": {
          "const": "consumer-layout-resolution.v1"
        },
        "resolution_id": {
          "$ref": "#/$defs/id"
        },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface_id",
            "archetype_id",
            "parent_component",
            "consumer_role",
            "layout_authority",
            "placement_claim"
          ],
          "properties": {
            "surface_id": {
              "$ref": "#/$defs/id"
            },
            "archetype_id": {
              "const": "optimized-event-card-grid"
            },
            "parent_component": {
              "const": "OptimizedEventCardGrid"
            },
            "consumer_role": {
              "$ref": "#/$defs/id"
            },
            "layout_authority": {
              "const": "astro-reference"
            },
            "placement_claim": {
              "enum": [
                "controlled-layout-only",
                "source-reachable",
                "production-observed"
              ]
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewport_id",
            "width_px",
            "height_px",
            "device_scale_factor",
            "breakpoint"
          ],
          "properties": {
            "viewport_id": {
              "$ref": "#/$defs/id"
            },
            "width_px": {
              "$ref": "#/$defs/positiveNumber"
            },
            "height_px": {
              "$ref": "#/$defs/positiveNumber"
            },
            "device_scale_factor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            },
            "breakpoint": {
              "const": "desktop"
            }
          }
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "containing_block",
            "width_expression",
            "border_box_width_px",
            "content_width_px",
            "padding_inline_px",
            "box_sizing"
          ],
          "properties": {
            "containing_block": {
              "const": "page-shell"
            },
            "width_expression": {
              "const": "min(1180px, viewport_width_px - 32px)"
            },
            "border_box_width_px": {
              "$ref": "#/$defs/positiveNumber"
            },
            "content_width_px": {
              "$ref": "#/$defs/positiveNumber"
            },
            "padding_inline_px": {
              "type": "number",
              "minimum": 0
            },
            "box_sizing": {
              "const": "border-box"
            }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "columns",
            "gap_expression",
            "column_gap_px",
            "row_gap_px",
            "track_definition",
            "align_items"
          ],
          "properties": {
            "display": {
              "const": "grid"
            },
            "columns": {
              "const": 3
            },
            "gap_expression": {
              "const": "clamp(0.85rem, 1.6vw, 1.25rem)"
            },
            "column_gap_px": {
              "type": "number",
              "minimum": 0
            },
            "row_gap_px": {
              "type": "number",
              "minimum": 0
            },
            "track_definition": {
              "const": "repeat(3, minmax(0, 1fr))"
            },
            "align_items": {
              "const": "stretch"
            }
          }
        },
        "packing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "limit",
            "row_size",
            "ordered_input_fixture_ids",
            "ordered_output_fixture_ids",
            "placement"
          ],
          "properties": {
            "algorithm": {
              "const": "packRelatedCardRows"
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            },
            "row_size": {
              "const": 3
            },
            "ordered_input_fixture_ids": {
              "$ref": "#/$defs/fixtureIds"
            },
            "ordered_output_fixture_ids": {
              "$ref": "#/$defs/fixtureIds"
            },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixture_id",
                "row_index",
                "column_index",
                "row_ratio",
                "media_ratio",
                "row_mode"
              ],
              "properties": {
                "fixture_id": {
                  "$ref": "#/$defs/fixtureId"
                },
                "row_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "column_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "row_ratio": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "media_ratio": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "row_mode": {
                  "enum": [
                    "visual-compact-5x4",
                    "document-led-bounded-cover",
                    "document-led-uncropped"
                  ]
                }
              }
            }
          }
        },
        "row_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peer_fixture_ids",
            "equal_height_policy",
            "height_basis",
            "card_height_style",
            "internal_track_definition",
            "tallest_sibling_determines_used_height",
            "shared_media_ratio_within_row"
          ],
          "properties": {
            "peer_fixture_ids": {
              "$ref": "#/$defs/fixtureIds"
            },
            "equal_height_policy": {
              "const": "equal-height-within-row"
            },
            "height_basis": {
              "const": "row-track-max-content"
            },
            "card_height_style": {
              "const": "100%"
            },
            "internal_track_definition": {
              "const": "auto minmax(0, 1fr) minmax(58px, auto) minmax(56px, auto)"
            },
            "tallest_sibling_determines_used_height": {
              "const": true
            },
            "shared_media_ratio_within_row": {
              "const": true
            }
          }
        },
        "used_card_geometry": {
          "$ref": "#/$defs/usedGeometry"
        },
        "media_available_box": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available_width_px",
            "available_height_px",
            "frame_aspect_ratio",
            "geometry_source",
            "measured_rect"
          ],
          "properties": {
            "available_width_px": {
              "$ref": "#/$defs/positiveNumber"
            },
            "available_height_px": {
              "$ref": "#/$defs/positiveNumber"
            },
            "frame_aspect_ratio": {
              "$ref": "#/$defs/positiveNumber"
            },
            "geometry_source": {
              "const": "used-card-width-divided-by-row-ratio"
            },
            "measured_rect": {
              "$ref": "#/$defs/measuredRect"
            }
          }
        },
        "framing_rule": {
          "$ref": "#/$defs/framingRule"
        },
        "candidate_deltas": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/candidateDelta"
          }
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolution_order",
            "source_refs",
            "formulas",
            "rounding_digits"
          ],
          "properties": {
            "resolution_order": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "surface-archetype"
                },
                {
                  "const": "viewport-container"
                },
                {
                  "const": "grid-columns"
                },
                {
                  "const": "packing-placement"
                },
                {
                  "const": "row-sibling-equalization"
                },
                {
                  "const": "used-card-geometry"
                },
                {
                  "const": "media-available-box"
                },
                {
                  "const": "framing-rule"
                }
              ],
              "items": false,
              "minItems": 8,
              "maxItems": 8
            },
            "source_refs": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "formulas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "container_width",
                "resolved_gap",
                "used_card_width",
                "media_available_height"
              ],
              "properties": {
                "container_width": {
                  "const": "min(1180, viewport_width_px - 32)"
                },
                "resolved_gap": {
                  "const": "min(max(13.6, viewport_width_px * 0.016), 20)"
                },
                "used_card_width": {
                  "const": "(container_width_px - 2 * resolved_gap_px) / 3"
                },
                "media_available_height": {
                  "const": "used_card_width_px / row_ratio"
                }
              }
            },
            "rounding_digits": {
              "type": "integer",
              "minimum": 6,
              "maximum": 12
            }
          }
        }
      }
    },
    "consumer_layout_resolution_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,159}$"
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 8192
    },
    "framingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "policy_id",
        "media_kind",
        "frame_aspect_ratio",
        "fit",
        "object_position",
        "crop_fraction",
        "crop_reason",
        "safe_crop_evidence"
      ],
      "properties": {
        "authority": {
          "const": "astro-reference"
        },
        "policy_id": {
          "$ref": "#/$defs/id"
        },
        "media_kind": {
          "enum": [
            "visual",
            "document",
            "missing"
          ]
        },
        "frame_aspect_ratio": {
          "$ref": "#/$defs/positiveNumber"
        },
        "fit": {
          "enum": [
            "cover",
            "contain",
            "source-preserving"
          ]
        },
        "object_position": {
          "type": "string",
          "minLength": 1
        },
        "crop_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "crop_reason": {
          "type": "string",
          "minLength": 1
        },
        "safe_crop_evidence": {
          "type": "boolean"
        }
      }
    },
    "candidateDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_id",
        "owner_decision_ref",
        "authority_scope",
        "region",
        "property",
        "astro_value",
        "candidate_value",
        "reason",
        "does_not_change_reference_authority",
        "promotion_effect"
      ],
      "properties": {
        "delta_id": {
          "$ref": "#/$defs/id"
        },
        "owner_decision_ref": {
          "type": "string",
          "pattern": "^catalog/normalization/event-media/framing-v2\\.json#"
        },
        "authority_scope": {
          "const": "penpot-candidate-only"
        },
        "region": {
          "const": "media"
        },
        "property": {
          "const": "framing-rule"
        },
        "astro_value": {
          "$ref": "#/$defs/framingValue"
        },
        "candidate_value": {
          "$ref": "#/$defs/framingValue"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "does_not_change_reference_authority": {
          "const": true
        },
        "promotion_effect": {
          "const": "none-before-owner-browser-approval"
        }
      }
    },
    "framingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_aspect_ratio",
        "fit",
        "object_position",
        "crop_fraction",
        "policy"
      ],
      "properties": {
        "frame_aspect_ratio": {
          "$ref": "#/$defs/positiveNumber"
        },
        "fit": {
          "enum": [
            "cover",
            "contain",
            "source-preserving"
          ]
        },
        "object_position": {
          "type": "string",
          "minLength": 1
        },
        "crop_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^event\\.real\\.[0-9]+$"
    },
    "fixtureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixtureId"
      }
    },
    "measuredRect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "x_px",
        "y_px",
        "width_px",
        "height_px",
        "capture_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "runtime-measurement-required",
            "runtime-measured"
          ]
        },
        "x_px": {
          "type": [
            "number",
            "null"
          ]
        },
        "y_px": {
          "type": [
            "number",
            "null"
          ]
        },
        "width_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/positiveNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "height_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/positiveNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "runtime-measurement-required"
              }
            }
          },
          "then": {
            "properties": {
              "x_px": {
                "type": "null"
              },
              "y_px": {
                "type": "null"
              },
              "width_px": {
                "type": "null"
              },
              "height_px": {
                "type": "null"
              },
              "capture_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "usedGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "height_resolution",
        "box_sizing",
        "measured_rect"
      ],
      "properties": {
        "width_px": {
          "$ref": "#/$defs/positiveNumber"
        },
        "height_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/positiveNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "height_resolution": {
          "const": "row-track-max-content-runtime-measurement-required"
        },
        "box_sizing": {
          "const": "border-box"
        },
        "measured_rect": {
          "$ref": "#/$defs/measuredRect"
        }
      }
    }
  }
}
