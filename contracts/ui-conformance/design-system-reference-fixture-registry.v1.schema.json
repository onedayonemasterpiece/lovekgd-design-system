{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.example/contracts/design-system-reference-fixture-registry.v1.schema.json",
  "title": "Design-system reference fixture registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "reference_clock", "entity_sources", "fixtures", "pools"],
  "properties": {
    "schema_version": { "const": "design-system-reference-fixture-registry.v1" },
    "registry_id": { "const": "design-system-reference-v1" },
    "reference_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "timezone", "locale"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "timezone": { "const": "Europe/Kaliningrad" },
        "locale": { "const": "ru-RU" }
      }
    },
    "entity_sources": { "type": "object" },
    "fixtures": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "entity_type", "source_id", "payload_sha256", "coverage", "asset"],
        "properties": {
          "fixture_id": { "type": "string", "pattern": "^event\\.real\\.[0-9]+$" },
          "entity_type": { "const": "event" },
          "source_id": { "type": "integer", "minimum": 1 },
          "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "coverage": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "asset": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "sha256"],
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            ]
          }
        }
      }
    },
    "pools": { "type": "object" }
  }
}
