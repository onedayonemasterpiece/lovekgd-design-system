{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.dev/schemas/ui-reference-event-corpus.v2.schema.json",
  "title": "Immutable UI reference event corpus v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "version", "immutable", "purpose", "reference_clock", "source", "fixtures", "projection_paths", "assets_manifest_path", "surface_expectations_path", "corpus_sha256"],
  "properties": {
    "schema_version": {"const": "ui-reference-event-corpus.v2"},
    "corpus_id": {"const": "ui-reference-events.v2"},
    "version": {"const": "v2"},
    "immutable": {"const": true},
    "purpose": {"const": "cross-surface-event-card-visual-diagnostics"},
    "reference_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_date", "reference_iso", "timezone"],
      "properties": {
        "current_date": {"type": "string", "format": "date"},
        "reference_iso": {"type": "string", "format": "date-time"},
        "timezone": {"const": "Europe/Kaliningrad"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "repository_sha", "static_build_id", "snapshot", "preview_export_sha256", "preview_contract"],
      "properties": {
        "repository": {"const": "onedayonemasterpiece/events-bot-new"},
        "repository_sha": {"$ref": "#/$defs/gitSha"},
        "static_build_id": {"type": "string", "minLength": 1},
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256", "scope"],
          "properties": {
            "kind": {"const": "preview-export-catalog-revision"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "scope": {"const": "bounded-production-slice"}
          }
        },
        "preview_export_sha256": {"$ref": "#/$defs/sha256"},
        "preview_contract": {"const": "PreviewEvent"}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["schema_version", "fixture_id", "event_id", "source_prod_id", "slug", "source_repository_sha", "source_static_build_id", "source_snapshot", "extracted_at", "preview_event_sha256", "payload_path", "coverage_tags"],
        "properties": {
          "schema_version": {"const": "ui-reference-event.v2"},
          "fixture_id": {"pattern": "^event\\.real\\.[0-9]+$"},
          "event_id": {"type": "integer", "minimum": 1},
          "source_repository_sha": {"$ref": "#/$defs/gitSha"},
          "preview_event_sha256": {"$ref": "#/$defs/sha256"},
          "source_snapshot": {
            "type": "object",
            "required": ["kind", "sha256"],
            "properties": {
              "kind": {"const": "preview-export-catalog-revision"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "projection_paths": {
      "const": ["projections/free-collection-september.v1.json"]
    },
    "assets_manifest_path": {"const": "assets-manifest.json"},
    "surface_expectations_path": {"const": "surface-expectations.json"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}
