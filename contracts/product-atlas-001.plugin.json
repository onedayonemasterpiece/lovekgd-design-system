{
  "schema_version": "lovekgd-product-atlas-plugin-contract-v1",
  "delivery_id": "product-atlas-001",
  "separate_from": "resource-graph-004a",
  "catalog": {
    "kind": "lovekgd-product-atlas",
    "source_of_product_truth": "onedayonemasterpiece/events-bot-new",
    "automatic_db_access": false,
    "accepted_analysis_records_only": true
  },
  "file_guard": {
    "file_kind": "product-atlas",
    "managed_namespace": "lovekgd.productatlas.001",
    "forbidden_namespaces": [
      "lovekgd.resourcegraph.004a",
      "lovekgd.runtime.003"
    ],
    "fail_closed": true,
    "symmetric_resource_graph_guard_required_for_joint_acceptance": true
  },
  "interaction": {
    "plugin_open_per_update": 1,
    "maximum_user_actions": 3,
    "actions": [
      "check-currentness",
      "update-product-atlas",
      "build-systemic-review-prompt"
    ],
    "forbidden_actions": [
      "import-design-system",
      "update-resource-graph",
      "write-github",
      "close-comments-automatically",
      "continue-next-batch-manually"
    ]
  },
  "permissions": [
    "content:read",
    "content:write",
    "comment:read"
  ],
  "forbidden_permissions": [
    "library:write"
  ],
  "penpot_pages": [
    "00 — Executive / Problem Radar",
    "10 — Stakeholders, Jobs and outcomes",
    "20 — Journeys and capabilities",
    "30 — Delivery, coverage and readiness",
    "40 — Findings, incidents and decisions",
    "50 — UI and design evidence",
    "80 — Candidate decisions",
    "89 — Decision archive",
    "99 — Technical diagnostics"
  ],
  "comment_prompt": {
    "default_scope": "all_unresolved_current_product_atlas_comments",
    "selected_entity_scope_supported": true,
    "preserve_thread_ids": true,
    "systemic_synthesis_required": true,
    "automatic_comment_resolution": false,
    "automatic_product_write": false
  }
}
