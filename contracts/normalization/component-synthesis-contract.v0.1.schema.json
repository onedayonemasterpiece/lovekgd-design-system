{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.example/contracts/normalization/component-synthesis-contract.v0.1.schema.json",
  "title": "LoveKGD component synthesis candidate contract v0.1",
  "description": "Strict candidate-only W1-W4 component contract. Validation does not accept, canonicalize, promote or authorize runtime migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_version",
    "stable_component_id",
    "display_name",
    "wave_id",
    "entity_kind",
    "semantic_purpose",
    "candidate_disposition",
    "status",
    "anatomy",
    "props",
    "slots",
    "nested_components",
    "variant_axes",
    "state_axes",
    "allowed_combinations",
    "invalid_combinations",
    "responsive_container_behavior",
    "content_constraints",
    "accessibility_requirements",
    "source",
    "consumers",
    "fixture_plan",
    "media",
    "loading_recovery",
    "penpot_binding",
    "evidence"
  ],
  "properties": {
    "$schema": {
      "const": "https://lovekgd.example/contracts/normalization/component-synthesis-contract.v0.1.schema.json"
    },
    "schema_version": {
      "const": "lovekgd_component_synthesis_contract_v0_1"
    },
    "contract_version": {
      "const": "0.1.0-candidate"
    },
    "stable_component_id": {
      "$ref": "#/$defs/entityRef"
    },
    "display_name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "wave_id": {
      "enum": [
        "W1-core-and-actions",
        "W2-event-media-and-actions",
        "W3-card-listing-navigation",
        "W4-domain-product-specific"
      ]
    },
    "entity_kind": {
      "enum": [
        "primitive_component",
        "control_component",
        "navigation_component",
        "content_component",
        "composite_component",
        "product_pattern"
      ]
    },
    "semantic_purpose": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "candidate_disposition": {
      "enum": [
        "candidate_component",
        "candidate_composition",
        "preserve_product_specific"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_mode",
        "canonical",
        "accepted",
        "promotion_ready",
        "contract_decision_status",
        "product_value_status"
      ],
      "properties": {
        "authority_mode": {
          "const": "reconstructed"
        },
        "canonical": {
          "const": false
        },
        "accepted": {
          "const": false
        },
        "promotion_ready": {
          "const": false
        },
        "contract_decision_status": {
          "const": "draft"
        },
        "product_value_status": {
          "const": "pending_product_model"
        }
      }
    },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part_id",
          "label",
          "required",
          "evidence_source"
        ],
        "properties": {
          "part_id": {
            "$ref": "#/$defs/localId"
          },
          "label": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "required": {
            "type": "boolean"
          },
          "evidence_source": {
            "const": "entity_registry.anatomy"
          }
        }
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prop_id",
          "kind",
          "type",
          "required",
          "allowed_values",
          "default",
          "evidence_source"
        ],
        "properties": {
          "prop_id": {
            "$ref": "#/$defs/localId"
          },
          "kind": {
            "enum": [
              "variant_axis",
              "state_axis",
              "materialization_binding"
            ]
          },
          "type": {
            "enum": [
              "enum",
              "fixture_ref"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "allowed_values": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "default": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_source": {
            "enum": [
              "entity_registry.variant_axes",
              "entity_registry.state_axes",
              "penpot_materialization_plan.fixture_requirements"
            ]
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "role",
          "required",
          "accepts_entity_refs",
          "content_constraints",
          "detached_copy_allowed"
        ],
        "properties": {
          "slot_id": {
            "$ref": "#/$defs/localId"
          },
          "role": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "required": {
            "type": "boolean"
          },
          "accepts_entity_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/entityRef"
            }
          },
          "content_constraints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "detached_copy_allowed": {
            "const": false
          }
        }
      }
    },
    "nested_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_ref",
          "relation",
          "slot_id",
          "required",
          "instance_required"
        ],
        "properties": {
          "entity_ref": {
            "$ref": "#/$defs/entityRef"
          },
          "relation": {
            "enum": [
              "contains_instance",
              "selects_one_instance"
            ]
          },
          "slot_id": {
            "$ref": "#/$defs/localId"
          },
          "required": {
            "type": "boolean"
          },
          "instance_required": {
            "const": true
          },
          "when_case_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "multiplicity_by_case": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        }
      }
    },
    "variant_axes": {
      "$ref": "#/$defs/axisList"
    },
    "state_axes": {
      "$ref": "#/$defs/axisList"
    },
    "allowed_combinations": {
      "$ref": "#/$defs/combinationList"
    },
    "invalid_combinations": {
      "$ref": "#/$defs/combinationList"
    },
    "responsive_container_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "evidence_source",
        "viewport_fixture_ids",
        "numeric_tokens_added"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_source": {
          "const": "entity_registry.responsive_behavior"
        },
        "viewport_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "numeric_tokens_added": {
          "const": false
        }
      }
    },
    "content_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "text_fixture_ids",
        "count_fixture_ids",
        "numeric_tokens_added"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "count_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "numeric_tokens_added": {
          "const": false
        }
      }
    },
    "accessibility_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_implementations",
        "mapping_refs"
      ],
      "properties": {
        "source_implementations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "mapping_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "consumers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_refs",
        "archetype_refs"
      ],
      "properties": {
        "entity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityRef"
          }
        },
        "archetype_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "fixture_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_ref",
        "binding_ref",
        "text_fixture_ids",
        "viewport_fixture_ids",
        "count_fixture_ids",
        "runtime_fixture_ids",
        "media_fixture_ids"
      ],
      "properties": {
        "catalog_ref": {
          "const": "catalog/normalization/component-synthesis-v0.1/fixtures/fixture-catalog.json"
        },
        "binding_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "viewport_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "count_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "runtime_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "media_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "consumer_scoped",
        "global_ratio_selected",
        "global_fit_selected",
        "source_behavior",
        "consumer_requirement_refs",
        "semantic_modes",
        "ratio_candidates",
        "fit_candidates",
        "focal_point",
        "safe_area",
        "upscale",
        "layout_reservation",
        "loading_applicability"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "delegated",
            "identity_asset",
            "not_applicable"
          ]
        },
        "consumer_scoped": {
          "const": true
        },
        "global_ratio_selected": {
          "const": false
        },
        "global_fit_selected": {
          "const": false
        },
        "source_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consumer_requirement_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "semantic_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "ratio_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "4:5",
              "5:4",
              "3:2",
              "2:3",
              "1:1",
              "intrinsic/source",
              "consumer-defined"
            ]
          }
        },
        "fit_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "cover",
              "contain",
              "source-preserving"
            ]
          }
        },
        "focal_point": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "safe_area": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upscale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "layout_reservation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "loading_applicability": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resolver_contract_ref": {
          "const": "catalog/normalization/component-synthesis-v0.1/event-media-resolver-contract.json"
        },
        "consumer_profile_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^profile\\.[a-z0-9.-]+$"
          }
        }
      }
    },
    "loading_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_policy",
        "static_html_skeleton",
        "client_wait_skeleton",
        "runtime_state_fixture_ids",
        "recovery_states"
      ],
      "properties": {
        "source_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "static_html_skeleton": {
          "const": "forbidden"
        },
        "client_wait_skeleton": {
          "enum": [
            "not_applicable_without_proven_client_wait",
            "allowed_only_for_proven_client_wait_with_known_geometry"
          ]
        },
        "runtime_state_fixture_ids": {
          "$ref": "#/$defs/fixtureRefList"
        },
        "recovery_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "static_resolved",
              "partial",
              "empty",
              "error",
              "offline",
              "unavailable",
              "success"
            ]
          }
        }
      }
    },
    "penpot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_graph_file_id",
        "target_page",
        "stable_plugin_data_id",
        "component_id",
        "variant_container_id",
        "main_component_id",
        "materialization_status",
        "binding_status",
        "fixture_binding_ids",
        "detached_copy_allowed",
        "screenshot_master_allowed"
      ],
      "properties": {
        "resource_graph_file_id": {
          "const": "3be9e5e1-190f-8090-8008-713c0fbe6260"
        },
        "target_page": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stable_plugin_data_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "component_id": {
          "type": "null"
        },
        "variant_container_id": {
          "type": "null"
        },
        "main_component_id": {
          "type": "null"
        },
        "materialization_status": {
          "const": "planned"
        },
        "binding_status": {
          "const": "placeholder"
        },
        "fixture_binding_ids": {
          "$ref": "#/$defs/bindingRefList"
        },
        "detached_copy_allowed": {
          "const": false
        },
        "screenshot_master_allowed": {
          "const": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_ref",
        "hierarchy_refs",
        "notes",
        "confidence",
        "level"
      ],
      "properties": {
        "registry_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "hierarchy_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "level": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "entityRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "fixtureRefList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixture\\.[a-z0-9][a-z0-9._-]*$"
      }
    },
    "bindingRefList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixture-binding\\.[a-z0-9][a-z0-9._-]*$"
      }
    },
    "axisList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis_id",
          "values",
          "materialization_mode",
          "evidence_source"
        ],
        "properties": {
          "axis_id": {
            "$ref": "#/$defs/localId"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "materialization_mode": {
            "const": "native_variant"
          },
          "evidence_source": {
            "enum": [
              "entity_registry.variant_axes",
              "entity_registry.state_axes"
            ]
          }
        }
      }
    },
    "combinationList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "combination_id",
          "rule",
          "axis_selections"
        ],
        "properties": {
          "combination_id": {
            "$ref": "#/$defs/localId"
          },
          "rule": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "axis_selections": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
