            {
              "const": "runtime-evidence-ref"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        "minimum_viewport_classes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "mobile"
            },
            {
              "const": "desktop"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "tablet_required_when_responsive_boundary": {
          "const": true
        },
        "detached_mockup_forbidden": {
          "const": true
        }
      }
    },
    "gemini_mcp_visual_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "allowed_model_ids",
        "mcp_mode",
        "mutation_allowed",
        "comment_resolution_allowed",
        "authority_change_allowed",
        "may_review",
        "cannot_prove",
        "supplementary_models_do_not_satisfy_gate",
        "provider_failure_status",
        "required_receipt_fields"
      ],
      "properties": {
        "role": {
          "const": "advisory-visual-and-semantic-review"
        },
        "allowed_model_ids": {
          "type": "array",
          "prefixItems": [
            {
              "const": "gemini-3-pro-preview"
            },
            {
              "const": "gemini-3.1-pro-preview"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "mcp_mode": {
          "const": "read-only"
        },
        "mutation_allowed": {
          "const": false
        },
        "comment_resolution_allowed": {
          "const": false
        },
        "authority_change_allowed": {
          "const": false
        },
        "may_review": {
          "type": "array",
          "prefixItems": [
            {
              "const": "visual hierarchy"
            },
            {
              "const": "composition"
            },
            {
              "const": "native component reuse"
            },
            {
              "const": "visible state coverage"
            },
            {
              "const": "responsive consistency"
            },
            {
              "const": "visible accessibility risks"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "cannot_prove": {
          "type": "array",
          "prefixItems": [
            {
              "const": "DOM semantics"
            },
            {
              "const": "accessibility tree"
            },
            {
              "const": "keyboard behavior"
            },
            {
              "const": "runtime reachability"
            },
            {
              "const": "contract or hash equality"
            },
            {
              "const": "state completeness"
            },
            {
              "const": "three-way conformance"
            },
            {
              "const": "owner acceptance"
            },
            {
              "const": "production release"
            },
            {
              "const": "promotion"
            }
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "supplementary_models_do_not_satisfy_gate": {
          "const": true
        },
        "provider_failure_status": {
          "const": "blocked"
        },
        "required_receipt_fields": {
          "type": "array",
          "prefixItems": [
            {
              "const": "model_id"
            },
            {
              "const": "provider"
            },
            {
              "const": "prompt_sha256"
            },
            {
              "const": "input_manifest_sha256"
            },
            {
              "const": "tool_log_sha256"
            },
            {
              "const": "response_sha256"
            },
            {
              "const": "started_at"
            },
            {
              "const": "completed_at"
            },
            {
              "const": "full_resolution_inputs_reviewed"
            },
            {
              "const": "limitations"
            }
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        }
      }
    },
    "invalidation_rules": {
      "type": "array",
      "prefixItems": [
        {
          "const": {
            "change": "contract identity, public API, anatomy or state vocabulary",
            "restart_at": "CANDIDATE_CONTRACT_ACCEPTED"
          }
        },
        {
          "const": {
            "change": "candidate code only",
            "replay_from": "CANONICAL_CODE_CANDIDATE"
          }
        },
        {
          "const": {
            "change": "Penpot implementation only",
            "replay_from": "PENPOT_COMPONENT_CANDIDATE"
          }
        },
        {
          "const": {
            "change": "archetype composition only",
            "replay_from": "PAGE_ARCHETYPE_CANDIDATE"
          }
        },
        {
          "const": {
            "change": "representation or fixture only",
            "replay_from": "PRODUCT_REPRESENTATIONS"
          }
        },
        {
          "const": {
            "change": "any visual output after Gemini audit",
            "requires": "focused Pro-class visual re-audit before promotion"
          }
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "promotion_invariants": {
      "type": "array",
      "prefixItems": [
        {
          "const": "authority_mode remains reconstructed through REVIEWED_CORRECTIONS"
        },
        {
          "const": "only T10_PROMOTE_FAMILY_AND_ARCHETYPES changes authority"
        },
        {
          "const": "promotion is atomic for one bounded family and its affected archetype set"
        },
        {
          "const": "no application with pending_product_model or promotion_ready=false may be promoted"
        },
        {
          "const": "Penpot is a visual implementation of the promoted contract, not the sole executable authority"
        },
        {
          "const": "actual runtime evidence never updates an accepted baseline automatically"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    }
  },
  "$defs": {
    "stateName": {
      "type": "string",
      "enum": [
        "AS_IS_RECONSTRUCTED",
        "FAMILY_HYPOTHESIS_REVIEWED",
        "CANDIDATE_CONTRACT_ACCEPTED",
        "CANONICAL_CODE_CANDIDATE",
        "PENPOT_COMPONENT_CANDIDATE",
        "COMPONENT_THREE_WAY_CONFORMANCE",
        "PAGE_ARCHETYPE_CANDIDATE",
        "PRODUCT_REPRESENTATIONS",
        "GEMINI_MCP_VISUAL_AUDIT",
        "REVIEWED_CORRECTIONS",
        "FAMILY_AND_ARCHETYPE_PROMOTION"
      ]
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stateDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "ordinal",
        "meaning",
        "entry_transition_id",
        "authority_mode",
        "allowed_claims",
        "forbidden_claims"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/stateName"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "entry_transition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_mode": {
          "enum": [
            "reconstructed",
            "design-system-led"
          ]
        },
        "allowed_claims": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "forbidden_claims": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "transitionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "from",
        "to",
        "gate",
        "authority",
        "evidence"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "pattern": "^T(0[1-9]|10)_[A-Z0-9_]+$"
        },
        "from": {
          "$ref": "#/$defs/stateName"
        },
        "to": {
          "$ref": "#/$defs/stateName"
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate_id",
            "mode",
            "requirements",
            "blocking_conditions"
          ],
          "properties": {
            "gate_id": {
              "type": "string",
              "pattern": "^G(0[1-9]|10)_[A-Z0-9_]+$"
            },
            "mode": {
              "const": "all_of"
            },
            "requirements": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "blocking_conditions": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "before",
            "after",
            "authority_change"
          ],
          "properties": {
            "before": {
              "enum": [
                "reconstructed",
                "design-system-led"
              ]
            },
            "after": {
              "enum": [
                "reconstructed",
                "design-system-led"
              ]
            },
            "authority_change": {
              "type": "boolean"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_kinds",
            "identity_fields",
            "all_refs_sha256_bound"
          ],
          "properties": {
            "required_kinds": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "identity_fields": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "all_refs_sha256_bound": {
              "const": true
            }
          }
        }
      }
    }
  }
}
