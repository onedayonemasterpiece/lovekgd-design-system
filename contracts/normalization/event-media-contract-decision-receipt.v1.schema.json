    "decision_id",
    "repository",
    "branch",
    "status",
    "lineage",
    "immutable_authority",
    "product_evidence",
    "census",
    "decision",
    "delivery",
    "constraints",
    "verification_contract",
    "output_count",
    "output_bytes",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "event_media_contract_decision_receipt_v1"},
    "decision_id": {"const": "event-media-contract-decision-v1"},
    "repository": {"const": "onedayonemasterpiece/lovekgd-design-system"},
    "branch": {"type": "string", "minLength": 1},
    "status": {"const": "BOUNDARY_COMPLETE_NOT_READY_WITH_EXACT_BLOCKERS"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_base_commit", "materialization_parent_commit", "required_ancestry"],
      "properties": {
        "design_base_commit": {"const": "45288b001d724e0d3603d0c44d392ff370407bd0"},
        "materialization_parent_commit": {"$ref": "#/$defs/gitSha"},
        "required_ancestry": {
          "type": "array",
          "prefixItems": [{"const": "45288b001d724e0d3603d0c44d392ff370407bd0"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "immutable_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder_tree", "component_decoder_tree", "decoder_manifest_sha256", "behavioral_manifest_sha256", "event_media_dossier_sha256", "exact_blockers_sha256", "penpot_tree", "prototypes_tree"],
      "properties": {
        "decoder_tree": {"const": "e77fc2457fadfdffb46ed2d90304ebb91e89a715"},
        "component_decoder_tree": {"const": "c2af02d0796f91b7510422db9b9e6179c70f606e"},
        "decoder_manifest_sha256": {"const": "f7740f7f533c3f0cda5d4d0b8ebe98b565d7f521368b96462daecbd26522d5cc"},
        "behavioral_manifest_sha256": {"const": "c676be4f2ad956b8a58c7707c8f71b7bb33afd771e506457309597e76d67d9a1"},
        "event_media_dossier_sha256": {"const": "935c9ffd99cfe0e0e7f0625d20473991f2b5946d77be21666b5e47a4a76923d4"},
        "exact_blockers_sha256": {"const": "77c1a288030173d1d1c25dd932dbf1ba8e576bc195702172a2c1b202981f7a46"},
        "penpot_tree": {"const": "b5cc94d35586f34554e8873e3a4380111057116d"},
        "prototypes_tree": {"const": "658fa4cbc942a1e8cc34c005cf3305a944b8e86f"}
      }
    },
    "product_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "site_src_tree", "site_public_tree", "production_source_mutated"],
      "properties": {
        "repository": {"const": "onedayonemasterpiece/events-bot-new"},
        "commit": {"const": "66bc0d43e36299417626f992021cfb7299ddf704"},
        "tree": {"const": "72e24f49ad6642915131438de8c56b804c4826b0"},
        "site_src_tree": {"const": "d737458f8a87a9b7dad4f4badffd1b3f4ce544dd"},
