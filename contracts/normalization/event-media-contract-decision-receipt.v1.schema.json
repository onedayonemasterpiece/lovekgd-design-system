{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onedayonemasterpiece/lovekgd-design-system/contracts/normalization/event-media-contract-decision-receipt.v1.schema.json",
  "title": "Event Media contract-decision receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
