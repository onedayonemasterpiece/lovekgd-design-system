      "properties": {
        "consumer_applications": {"const": 52},
        "semantic_records": {"const": 23},
        "boundary_records": {"const": 31},
        "exact_blockers": {"const": 12},
        "candidate_contracts": {"const": 3},
        "alternative_rows": {"const": 31},
        "readiness_rows": {"const": 3},
        "owner_questions": {"const": 2},
        "readiness_checks_per_candidate": {"const": 23},
        "ready_candidates": {"const": 0},
        "blocked_candidates": {"const": 3},
        "baseline_analytical_groups": {"const": 47},
        "baseline_component_memberships": {"const": 107},
        "baseline_not_ready": {"const": 47},
        "baseline_scored": {"const": 0},
        "baseline_first_wave": {"const": 0},
        "baseline_applications_pending_product_model": {"const": 239},
        "baseline_experiments_not_merged": {"const": 6},
        "observed_ratios": {"type": "array", "minItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "open_blocker_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EM-[A-Z]+-[0-9]{3}$"}},
        "blocker_status_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_status", "readiness_status", "final_statuses", "candidate_decision_accepted", "normalization_allowed", "physical_operation_authorized"],
      "properties": {
        "boundary_status": {"const": "EVENT_MEDIA_BOUNDARY_MODEL_COMPLETE"},
        "readiness_status": {"const": "EVENT_MEDIA_NOT_READY_WITH_EXACT_BLOCKERS"},
        "final_statuses": {
          "type": "array",
          "prefixItems": [
            {"const": "EVENT_MEDIA_BOUNDARY_MODEL_COMPLETE"},
            {"const": "EVENT_MEDIA_NOT_READY_WITH_EXACT_BLOCKERS"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "candidate_decision_accepted": {"const": false},
        "normalization_allowed": {"const": false},
        "physical_operation_authorized": {"const": false}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull_request"],
      "properties": {
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url", "draft", "status", "merge_requested", "merge_authorized"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "url": {"type": "string", "pattern": "^https://github\\.com/onedayonemasterpiece/lovekgd-design-system/pull/[0-9]+$"},
            "draft": {"const": true},
            "status": {"const": "open"},
            "merge_requested": {"const": false},
            "merge_authorized": {"const": false}
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["penpot_changed", "prototypes_changed", "production_ui_changed", "production_site_src_changed", "production_site_public_changed", "candidate_contract_accepted", "normalization_allowed", "physical_operation_authorized", "migration_started", "experiment_winner_selected", "product_model_created", "promotion_ready", "global_ratio_selected", "global_token_selected", "merge_or_deploy_authorized"],
      "properties": {
        "penpot_changed": {"const": false},
        "prototypes_changed": {"const": false},
        "production_ui_changed": {"const": false},
        "production_site_src_changed": {"const": false},
        "production_site_public_changed": {"const": false},
        "candidate_contract_accepted": {"const": false},
        "normalization_allowed": {"const": false},
        "physical_operation_authorized": {"const": false},
        "migration_started": {"const": false},
        "experiment_winner_selected": {"const": false},
        "product_model_created": {"const": false},
        "promotion_ready": {"const": false},
        "global_ratio_selected": {"const": false},
        "global_token_selected": {"const": false},
        "merge_or_deploy_authorized": {"const": false}
      }
    },
    "verification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_path", "committed_receipt_asserts_ci", "runtime_execution_evidence", "required_commands"],
      "properties": {
        "workflow_path": {"const": ".github/workflows/event-media-contract-decision-v1.yml"},
        "committed_receipt_asserts_ci": {"const": false},
        "runtime_execution_evidence": {"const": "github-actions-run-and-artifact-only"},
        "required_commands": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "output_count": {"type": "integer", "minimum": 1},
    "output_bytes": {"type": "integer", "minimum": 1},
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(?!receipts/normalization/event-media-contract-decision-v1\\.json$).+": {"$ref": "#/$defs/output"}
      }
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "records"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "records": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
