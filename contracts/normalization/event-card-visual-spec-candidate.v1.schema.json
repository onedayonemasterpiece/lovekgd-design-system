{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.example/contracts/normalization/event-card-visual-spec-candidate.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle", "authority_mode", "canonical", "source", "framing_ref", "visual_acceptance", "specimens"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "event_card_visual_spec_candidate_v1"},
    "lifecycle": {"const": "candidate"},
    "authority_mode": {"const": "reconstructed"},
    "canonical": {"const": false},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "authority_chain"],
      "properties": {
        "repository": {"const": "onedayonemasterpiece/events-bot-new"},
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "authority_chain": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      }
    },
    "framing_ref": {"type": "string", "minLength": 1},
    "visual_acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_families", "passed_families", "screenshots_are_oracle_only"],
      "properties": {
        "status": {"enum": ["not_ready", "passed"]},
        "required_families": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "passed_families": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "screenshots_are_oracle_only": {"const": true}
      }
    },
    "specimens": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "fixture", "source_paths", "selectors", "geometry", "typography", "colors", "anatomy", "media", "framing_profile", "penpot"],
        "properties": {
          "family": {"type": "string"},
          "fixture": {"type": "object"},
          "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "selectors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "geometry": {"type": "object"},
          "typography": {"type": "object"},
          "colors": {"type": "object"},
          "anatomy": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "media": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "framing_profile": {"type": "string"},
          "penpot": {"type": "object"}
        }
      }
    }
  }
}
