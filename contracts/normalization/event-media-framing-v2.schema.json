{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.example/contracts/normalization/event-media-framing-v2.schema.json",
  "title": "Event media framing candidate policy v2",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "policy_version",
    "contract_version",
    "contract_payload_sha256",
    "status",
    "lifecycle",
    "authority_mode",
    "canonical",
    "promotion_status",
    "authority",
    "rendering_invariants",
    "radii_px",
    "media_owners",
    "consumer_owned_slots",
    "large_card_resolution",
    "ocr_crop_policy",
    "composition_ownership",
    "fail_closed_behavior",
    "astro_bindings",
    "penpot_bindings",
    "evidence_requirements",
    "owner_comment_constraints",
    "acceptance",
    "non_claims"
  ],
  "properties": {
    "$schema": {
      "const": "https://lovekgd.example/contracts/normalization/event-media-framing-v2.schema.json"
    },
    "schema_version": {
      "const": "event_media_framing_v2"
    },
    "policy_version": {
      "const": "2.0.0-candidate"
    },
    "contract_version": {
      "const": "2.0.0-candidate"
    },
    "contract_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "CANDIDATE"
    },
    "lifecycle": {
      "const": "candidate"
    },
    "authority_mode": {
      "const": "reconstructed"
    },
    "canonical": {
      "const": false
    },
    "promotion_status": {
      "const": "not_promoted"
    },
    "observed_on": {
      "type": "string",
      "format": "date"
    },
    "implementation_status": {
      "const": "NOT_IMPLEMENTED_OR_RUNTIME_PROVEN"
    },
    "authority": {
      "type": "object"
    },
    "rendering_invariants": {
      "type": "object",
      "required": [
        "proportional_scale_only",
        "stretch_or_squash_forbidden",
        "media_internal_fields_forbidden",
        "forbidden_field_techniques",
        "protected_or_intrinsic_behavior",
        "blind_center_crop_forbidden"
      ],
      "properties": {
        "proportional_scale_only": {
          "const": true
        },
        "stretch_or_squash_forbidden": {
          "const": true
        },
        "media_internal_fields_forbidden": {
          "const": true
        },
        "forbidden_field_techniques": {
          "type": "array",
          "contains": {
            "const": "contain_inside_fixed_ratio_frame"
          }
        },
        "protected_or_intrinsic_behavior": {
          "type": "string",
          "minLength": 1
        },
        "blind_center_crop_forbidden": {
          "const": true
        }
      }
    },
    "radii_px": {
      "type": "object",
      "required": [
        "scope",
        "festival_card",
        "listing_event_card",
        "listing_rail_row",
        "event_card",
        "exhibition_row"
      ],
      "properties": {
        "scope": {
          "const": "consumer-specific-source-derived"
        },
        "festival_card": {
          "type": "object",
          "required": [
            "shell",
            "media"
          ],
          "properties": {
            "shell": {
              "const": 10
            },
            "media": {
              "const": 10
            }
          },
          "additionalProperties": false
        },
        "listing_event_card": {
          "type": "object",
          "required": [
            "media"
          ],
          "properties": {
            "media": {
              "const": 14
            }
          },
          "additionalProperties": false
        },
        "listing_rail_row": {
          "type": "object",
          "required": [
            "summary",
            "action"
          ],
          "properties": {
            "summary": {
              "const": 14
            },
            "action": {
              "const": 12
            }
          },
          "additionalProperties": false
        },
        "event_card": {
          "type": "object",
          "required": [
            "shell",
            "media_top"
          ],
          "properties": {
            "shell": {
              "const": 24
            },
            "media_top": {
              "const": 24
            }
          },
          "additionalProperties": false
        },
        "exhibition_row": {
          "type": "object",
          "required": [
            "mobile_shell",
            "desktop_shell",
            "undo_control"
          ],
          "properties": {
            "mobile_shell": {
              "const": 8
            },
            "desktop_shell": {
              "const": 0
            },
            "undo_control": {
              "const": 4
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "media_owners": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "owner",
          "owns",
          "nested_component"
        ]
      }
    },
    "consumer_owned_slots": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "penpot_board_id",
          "penpot_media_id",
          "sample_geometry",
          "ratio",
          "ownership"
        ]
      }
    },
    "large_card_resolution": {
      "type": "array",
      "minItems": 3
    },
    "ocr_crop_policy": {
      "type": "object",
      "required": [
        "axes",
        "maximum_total_source_area_loss",
        "forced_target_ratio",
        "asymmetric_crop_allowed",
        "requires_explicit_safe_crop",
        "requires_complete_protected_text_logo_and_valuable_regions",
        "geometry_within_budget_is_not_crop_permission",
        "result_ratio_source"
      ],
      "properties": {
        "maximum_total_source_area_loss": {
          "const": 0.2
        },
        "forced_target_ratio": {
          "type": "null"
        },
        "requires_explicit_safe_crop": {
          "const": true
        },
        "requires_complete_protected_text_logo_and_valuable_regions": {
          "const": true
        },
        "geometry_within_budget_is_not_crop_permission": {
          "const": true
        }
      }
    },
    "composition_ownership": {
      "type": "object",
      "required": [
        "multi_portrait_viewer",
        "paired_events",
        "event_media_frame_role_in_pair"
      ]
    },
    "fail_closed_behavior": {
      "type": "object",
      "required": [
        "unknown_source_geometry",
        "missing_safe_crop_evidence",
        "missing_protected_region_evidence",
        "invalid_crop_budget",
        "forbidden_internal_field_request"
      ]
    },
    "astro_bindings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "source",
          "runtime_markers",
          "evidence_status"
        ]
      }
    },
    "penpot_bindings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "binding_role"
        ]
      }
    },
    "evidence_requirements": {
      "type": "object",
      "required": [
        "consumer_binding_required",
        "source_dimensions_required_for_crop",
        "exact_safe_crop_region_required",
        "protected_region_union_required_for_ocr",
        "runtime_or_review_dom_marker_required_for_production_provenance",
        "penpot_visual_and_git_metadata_must_match_before_comment_resolution"
      ]
    },
    "supersedes_v1_claims": {
      "type": "array",
      "minItems": 1
    },
    "owner_comment_constraints": {
      "type": "array",
      "minItems": 3
    },
    "acceptance": {
      "type": "object"
    },
    "non_claims": {
      "type": "array",
      "contains": {
        "const": "production_implementation"
      }
    }
  },
  "additionalProperties": false
}
