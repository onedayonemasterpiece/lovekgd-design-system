{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.example/contracts/normalization/project-normalization-mutation-catalog.v1.schema.json",
  "title": "Project Normalization Mutation Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "receipt_validation_enabled",
    "aggregate_validator",
    "counts",
    "lane_suites",
    "mandatory_cases"
  ],
  "properties": {
    "$schema": {
      "const": "../../contracts/normalization/project-normalization-mutation-catalog.v1.schema.json"
    },
    "schema_version": {
      "const": "project_normalization_mutation_catalog_v1"
    },
    "status": {
      "const": "PASS"
    },
    "receipt_validation_enabled": {
      "const": false
    },
    "aggregate_validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "arguments", "receipt_disable_flag"],
      "properties": {
        "path": { "const": "scripts/validate-project-normalization-synthesis-v1-1.mjs" },
        "arguments": {
          "type": "array",
          "prefixItems": [
            { "const": "<fixture-root>" },
            { "const": "--fixture-mode" },
            { "const": "--skip-receipt" },
            { "const": "--semantic-only" }
          ],
          "items": false
        },
        "receipt_disable_flag": { "const": "--skip-receipt" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory_mutation_cases",
        "mandatory_cases_passed",
        "mandatory_cases_failed",
        "lane_negative_mutation_count",
        "positive_baseline_count",
        "total_negative_mutation_count",
        "baseline_rechecks"
      ],
      "properties": {
        "mandatory_mutation_cases": { "type": "integer", "const": 14 },
        "mandatory_cases_passed": { "type": "integer", "const": 14 },
        "mandatory_cases_failed": { "type": "integer", "const": 0 },
        "lane_negative_mutation_count": { "type": "integer", "minimum": 0 },
        "positive_baseline_count": { "type": "integer", "minimum": 0 },
        "total_negative_mutation_count": { "type": "integer", "minimum": 14 },
        "baseline_rechecks": { "type": "integer", "minimum": 15 }
      }
    },
    "lane_suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/laneSuite" }
    },
    "mandatory_cases": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/mandatoryCase" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "laneSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition_paths",
        "classification_method",
        "negative_cases",
        "positive_baseline_cases",
        "positive_preservation_cases",
        "negative_count",
        "positive_baseline_count",
        "positive_preservation_count"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "definition_paths": { "$ref": "#/$defs/stringArray" },
        "classification_method": { "type": "string", "minLength": 1 },
        "negative_cases": { "$ref": "#/$defs/stringArray" },
        "positive_baseline_cases": { "$ref": "#/$defs/stringArray" },
        "positive_preservation_cases": { "$ref": "#/$defs/stringArray" },
        "negative_count": { "type": "integer", "minimum": 0 },
        "positive_baseline_count": { "type": "integer", "minimum": 0 },
        "positive_preservation_count": { "type": "integer", "minimum": 0 }
      }
    },
    "structuredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "stage", "record", "path", "diagnostic"],
      "properties": {
        "name": { "const": "NormalizationValidationError" },
        "code": { "type": "string", "pattern": "^PNV_[A-Z0-9_]+$" },
        "stage": { "type": "string", "minLength": 1 },
        "record": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "diagnostic": { "type": "string", "minLength": 1 }
      }
    },
    "mandatoryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "lane",
        "kind",
        "target_validator",
        "mutation_description",
        "source_test_file",
        "mutation_files",
        "expected_error_code",
        "actual_error_code",
        "error",
        "named_proof_source",
        "aggregate_diagnostic_counted_as_named_proof",
        "targeted_rejected",
        "aggregate_rejected",
        "receipt_validation_enabled",
        "bytes_restored",
        "baseline_passed",
        "pass",
        "actions_result_binding"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "lane": { "type": "string", "minLength": 1 },
        "kind": { "const": "negative" },
        "target_validator": { "const": "scripts/normalization-v1-1/validate-mutation-candidate.mjs" },
        "mutation_description": { "type": "string", "minLength": 1 },
        "source_test_file": { "const": "tests/project-normalization-synthesis-v1-1-negative.mjs" },
        "mutation_files": { "$ref": "#/$defs/stringArray" },
        "expected_error_code": { "type": "string", "pattern": "^PNV_[A-Z0-9_]+$" },
        "actual_error_code": { "type": "string", "pattern": "^PNV_[A-Z0-9_]+$" },
        "error": { "$ref": "#/$defs/structuredError" },
        "named_proof_source": { "const": "targeted_candidate_validator" },
        "aggregate_diagnostic_counted_as_named_proof": { "const": false },
        "targeted_rejected": { "const": true },
        "aggregate_rejected": { "const": true },
        "receipt_validation_enabled": { "const": false },
        "bytes_restored": { "const": true },
        "baseline_passed": { "const": true },
        "pass": { "const": true },
        "actions_result_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result_path", "case_id", "exact_head_sha_field", "duration_ms_field"],
          "properties": {
            "result_path": { "const": "project-normalization-v1-1-mutation-results.json" },
            "case_id": { "type": "string", "minLength": 1 },
            "exact_head_sha_field": { "const": "exact_head_sha" },
            "duration_ms_field": { "const": "duration_ms" }
          }
        }
      }
    }
  }
}
