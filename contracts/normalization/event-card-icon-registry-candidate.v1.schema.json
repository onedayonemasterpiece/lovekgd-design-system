{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.example/contracts/normalization/event-card-icon-registry-candidate.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_payload_sha256", "source_baseline", "counts", "icons", "penpot_collection"],
  "properties": {
    "schema_version": {"const": "event-card-icon-registry-candidate.v1"},
    "contract_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical": {"const": false},
    "source_baseline": {
      "type": "object",
      "required": ["repository", "exact_commit", "iconography_contract_path", "iconography_contract_sha256"],
      "properties": {"exact_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "counts": {
      "type": "object",
      "required": ["icons", "current", "unclassified"],
      "properties": {
        "icons": {"type": "integer", "minimum": 1},
        "current": {"type": "integer", "minimum": 1},
        "unclassified": {"const": 0}
      }
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["icon_id", "penpot_name", "semantic_role", "source_type", "source_path", "source_sha256", "geometry_sha256", "source_view_box", "svg_markup", "optical_size_px", "decorative_or_informative", "license_or_provenance", "status", "production_consumers"],
        "properties": {
          "icon_id": {"type": "string", "pattern": "^icon\\."},
          "penpot_name": {"type": "string", "pattern": "^Icon/"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "geometry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "svg_markup": {"type": "string", "pattern": "^<svg"},
          "status": {"const": "current"},
          "production_consumers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "penpot_collection": {
      "type": "object",
      "required": ["page_id", "page_name", "status"]
    }
  }
}
