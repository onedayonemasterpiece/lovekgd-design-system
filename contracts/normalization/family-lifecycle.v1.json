      "authority_mode": "reconstructed",
      "allowed_claims": [
        "current implementation reconstructed at a pinned identity",
        "candidate family subject exists"
      ],
      "forbidden_claims": [
        "semantic family accepted",
        "candidate contract accepted",
        "Penpot component accepted",
        "promotion ready"
      ]
    },
    {
      "state": "FAMILY_HYPOTHESIS_REVIEWED",
      "ordinal": 2,
      "meaning": "A bounded semantic-family hypothesis has passed positive evidence review; an analytical group is not promoted merely because blockers are absent.",
      "entry_transition_id": "T01_REVIEW_FAMILY_HYPOTHESIS",
      "authority_mode": "reconstructed",
      "allowed_claims": [
        "semantic-family hypothesis reviewed",
        "target contract work may begin"
      ],
      "forbidden_claims": [
        "candidate contract accepted",
        "implementation authorized",
        "Penpot materialization authorized",
        "promotion ready"
      ]
    },
    {
      "state": "CANDIDATE_CONTRACT_ACCEPTED",
      "ordinal": 3,
      "meaning": "The owner accepted a versioned candidate target contract, reversible migration and rollback plan, and the definition of the final promotion gate.",
