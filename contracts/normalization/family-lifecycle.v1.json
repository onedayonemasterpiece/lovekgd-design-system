      "entry_transition_id": "T05_PASS_COMPONENT_THREE_WAY_CONFORMANCE",
      "authority_mode": "reconstructed",
      "allowed_claims": [
        "candidate component three-way capsule passed"
      ],
      "forbidden_claims": [
        "family promoted",
        "page archetype accepted",
        "production conformance permanently proven"
