  "normative_status": "accepted",
  "lifecycle_id": "lovekgd-design-system-family-and-archetype-lifecycle-v1",
  "scope": {
    "unit": "bounded-candidate-family-subject-and-affected-archetype-set",
    "initial_subject_may_be_analysis_group": true,
    "semantic_family_identity_begins_at": "FAMILY_HYPOTHESIS_REVIEWED",
    "global_promotion_forbidden": true
  },
  "current_repository_state": {
    "state": "AS_IS_RECONSTRUCTED",
    "reason": "No native Penpot components or accepted visual archetypes exist; all current family/application promotion flags are false and the Product Value Gate is observe/pending.",
    "promotion_claim_allowed": false
