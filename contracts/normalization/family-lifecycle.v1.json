      "authority_mode": "reconstructed",
      "allowed_claims": [
        "candidate target contract accepted for evaluation",
        "candidate implementation authorized"
      ],
      "forbidden_claims": [
        "contract promoted",
        "production import authorized",
        "Penpot normative",
        "authority transferred"
