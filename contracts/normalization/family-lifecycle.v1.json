    ],
    "product_representation_requires": [
      "one-archetype-ref",
      "exact-instance-graph",
      "fixture-id",
      "viewport-id",
      "screen-state-id",
      "ux-flow-ref",
      "runtime-evidence-ref"
    ],
    "minimum_viewport_classes": [
      "mobile",
      "desktop"
    ],
    "tablet_required_when_responsive_boundary": true,
    "detached_mockup_forbidden": true
  },
  "gemini_mcp_visual_audit": {
    "role": "advisory-visual-and-semantic-review",
    "allowed_model_ids": [
      "gemini-3-pro-preview",
      "gemini-3.1-pro-preview"
    ],
    "mcp_mode": "read-only",
    "mutation_allowed": false,
    "comment_resolution_allowed": false,
    "authority_change_allowed": false,
    "may_review": [
      "visual hierarchy",
      "composition",
      "native component reuse",
      "visible state coverage",
      "responsive consistency",
      "visible accessibility risks"
    ],
    "cannot_prove": [
      "DOM semantics",
      "accessibility tree",
      "keyboard behavior",
      "runtime reachability",
      "contract or hash equality",
      "state completeness",
      "three-way conformance",
      "owner acceptance",
      "production release",
      "promotion"
    ],
    "supplementary_models_do_not_satisfy_gate": true,
    "provider_failure_status": "blocked",
    "required_receipt_fields": [
      "model_id",
      "provider",
      "prompt_sha256",
      "input_manifest_sha256",
      "tool_log_sha256",
      "response_sha256",
      "started_at",
      "completed_at",
      "full_resolution_inputs_reviewed",
      "limitations"
    ]
  },
  "invalidation_rules": [
    {
      "change": "contract identity, public API, anatomy or state vocabulary",
      "restart_at": "CANDIDATE_CONTRACT_ACCEPTED"
    },
    {
      "change": "candidate code only",
      "replay_from": "CANONICAL_CODE_CANDIDATE"
    },
    {
      "change": "Penpot implementation only",
      "replay_from": "PENPOT_COMPONENT_CANDIDATE"
    },
    {
      "change": "archetype composition only",
      "replay_from": "PAGE_ARCHETYPE_CANDIDATE"
    },
    {
      "change": "representation or fixture only",
      "replay_from": "PRODUCT_REPRESENTATIONS"
    },
    {
      "change": "any visual output after Gemini audit",
      "requires": "focused Pro-class visual re-audit before promotion"
    }
  ],
  "promotion_invariants": [
    "authority_mode remains reconstructed through REVIEWED_CORRECTIONS",
    "only T10_PROMOTE_FAMILY_AND_ARCHETYPES changes authority",
    "promotion is atomic for one bounded family and its affected archetype set",
    "no application with pending_product_model or promotion_ready=false may be promoted",
    "Penpot is a visual implementation of the promoted contract, not the sole executable authority",
    "actual runtime evidence never updates an accepted baseline automatically"
  ]
}
