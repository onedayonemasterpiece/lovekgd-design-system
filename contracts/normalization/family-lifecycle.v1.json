      "authority_mode": "reconstructed",
      "allowed_claims": [
        "candidate product representations complete for declared scope"
      ],
      "forbidden_claims": [
        "independent mockup is an archetype",
        "missing state is positive coverage",
        "representations are promoted"
      ]
    },
    {
      "state": "GEMINI_MCP_VISUAL_AUDIT",
      "ordinal": 9,
      "meaning": "An allowed Gemini Pro model completed an advisory visual audit over a hash-bound full-resolution bundle through read-only Penpot MCP inspection/export.",
      "entry_transition_id": "T08_COMPLETE_GEMINI_MCP_VISUAL_AUDIT",
      "authority_mode": "reconstructed",
      "allowed_claims": [
        "advisory visual audit complete",
        "structured visual findings recorded"
