{
  "schema_version": "lovekgd-penpot-resource-graph-plugin-contract-v1",
  "delivery_id": "resource-graph-004",
  "status": "candidate-transport-contract",
  "source": {
    "catalog_count_per_update": 1,
    "authority": "lifecycle-scoped",
    "reconstruction_authority": "pinned-exact-source-and-evidence",
    "promotion_authority": "accepted-production-release-inventory",
    "required_identity": [
      "repo_sha",
      "build_id",
      "run_id",
      "snapshot_id",
      "snapshot_sha256",
      "catalog_sha256"
    ],
    "forbid_arbitrary_main": true,
    "forbid_lab_as_inventory_authority": true
  },
  "lifecycle": {
    "contract_ref": "contracts/normalization/family-lifecycle.v1.json",
    "candidate_materialization_state": "PENPOT_COMPONENT_CANDIDATE",
    "candidate_mutation_states": [
      "PENPOT_COMPONENT_CANDIDATE",
      "PAGE_ARCHETYPE_CANDIDATE",
      "PRODUCT_REPRESENTATIONS",
      "REVIEWED_CORRECTIONS"
    ],
    "required_completed_states_before_materialization": [
      "CANDIDATE_CONTRACT_ACCEPTED",
      "CANONICAL_CODE_CANDIDATE"
    ],
    "candidate_authority_mode": "reconstructed",
    "candidate_status": "candidate",
    "candidate_canonical": false,
    "candidate_metadata_guard": {
      "current_state_must_be_allowed": true,
      "state_receipt_must_match_subject_and_candidate_hashes": true,
      "missing_stale_or_mismatched_evidence_effect": "abort-before-mutation",
      "partial_write_effect": "rollback-to-operation-checkpoint"
    },
    "promotion_side_effect_forbidden": true,
    "design_system_led_reconciliation_requires_existing_promotion_receipt": true,
    "required_candidate_metadata": [
      "lifecycle_contract_ref",
      "lifecycle_state",
      "subject_id",
      "candidate_contract_id",
      "candidate_contract_version",
      "candidate_contract_sha256",
      "code_candidate_repo_sha",
      "authority_mode",
      "status",
      "canonical",
      "promotion_receipt_ref",
      "materialization_receipt_ref",
      "rollback_ref"
    ]
  },
  "interaction": {
    "plugin_open_per_update": 1,
    "maximum_user_actions": 3,
    "auto_preflight_on_open": true,
    "actions": [
      {
        "id": "check-currentness",
        "label": "Проверить актуальность",
        "mutates_file": false,
        "optional": true
      },
      {
        "id": "update-everything",
        "label": "Обновить дизайн-систему",
        "mutates_file": true,
        "primary": true
      },
      {
        "id": "build-review-prompt",
        "label": "Собрать промпт по комментариям",
        "mutates_file": false
      }
    ],
    "forbidden_actions": [
      "update-page",
      "update-component",
      "update-file",
      "continue-next-page",
      "import-next-batch-manually"
    ]
  },
  "update_everything_phases": [
