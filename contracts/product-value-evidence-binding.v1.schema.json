{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovekgd.design/contracts/product-value-evidence-binding.v1.schema.json",
  "title": "LoveKGD component application product-value evidence binding v1",
  "description": "Foreign-key-only binding from a concrete component application to product authority owned by events-bot-new. This schema never defines product entities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_id",
    "family_id",
    "component_contract_id",
    "component_contract_version",
    "consumer",
    "route",
    "surface_archetype_id",
    "value_evidence_mode",
    "value_evidence_status",
    "need_ids",
    "job_ids",
    "journey_ids",
    "capability_ids",
    "outcome_ids",
    "metric_ids",
    "guardrail_ids",
    "value_claim",
    "expected_mechanism",
    "evidence_refs",
    "decision_receipt",
    "product_authority",
    "product_value_gate_mode",
    "promotion_ready",
    "as_is_preservation_allowed"
  ],
  "properties": {
    "schema_version": { "const": "product_value_evidence_binding_v1" },
    "application_id": { "type": "string", "pattern": "^application\\.[a-f0-9]{16}$" },
    "family_id": { "type": "string", "pattern": "^family\\.[a-z0-9][a-z0-9.-]*$" },
    "component_contract_id": { "type": "string", "minLength": 1 },
    "component_contract_version": { "type": "string", "minLength": 1 },
    "consumer": { "type": "string", "minLength": 1 },
    "route": { "type": ["string", "null"] },
    "surface_archetype_id": { "type": "string", "minLength": 1 },
    "value_evidence_mode": {
      "enum": ["direct", "inherited", "enabler", "experimental"]
    },
    "value_evidence_status": {
      "enum": [
        "pending_product_model",
        "existing_authoritative_mapping",
        "hypothesis_only",
        "validated_qualitative",
        "validated_quantitative",
        "validated_production",
        "rejected"
      ]
    },
    "need_ids": { "$ref": "#/$defs/idArray" },
    "job_ids": { "$ref": "#/$defs/idArray" },
    "journey_ids": { "$ref": "#/$defs/idArray" },
    "capability_ids": { "$ref": "#/$defs/idArray" },
    "outcome_ids": { "$ref": "#/$defs/idArray" },
    "metric_ids": { "$ref": "#/$defs/idArray" },
    "guardrail_ids": { "$ref": "#/$defs/idArray" },
    "value_claim": { "type": ["string", "null"] },
    "expected_mechanism": { "type": ["string", "null"] },
    "evidence_refs": { "$ref": "#/$defs/idArray" },
    "decision_receipt": { "type": ["string", "null"] },
    "parent_application_id": { "type": ["string", "null"], "pattern": "^application\\.[a-f0-9]{16}$" },
    "enabler_kind": {
      "type": ["string", "null"],
      "enum": [null, "accessibility", "reliability", "consistency", "defect_reduction", "delivery_efficiency"]
    },
    "product_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "registry_status"],
      "properties": {
        "repository": { "const": "onedayonemasterpiece/events-bot-new" },
        "commit": { "const": "66bc0d43e36299417626f992021cfb7299ddf704" },
        "registry_status": { "const": "absent-at-pinned-commit" }
      }
    },
    "product_value_gate_mode": { "const": "observe" },
    "promotion_ready": { "type": "boolean" },
    "as_is_preservation_allowed": { "type": "boolean" },
    "adoption_evidence": { "$ref": "#/$defs/idArray" }
  },
  "$defs": {
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "value_evidence_status": { "const": "pending_product_model" } } },
      "then": {
        "properties": {
          "need_ids": { "maxItems": 0 },
          "job_ids": { "maxItems": 0 },
          "journey_ids": { "maxItems": 0 },
          "capability_ids": { "maxItems": 0 },
          "outcome_ids": { "maxItems": 0 },
          "metric_ids": { "maxItems": 0 },
          "guardrail_ids": { "maxItems": 0 },
          "value_claim": { "const": null },
          "expected_mechanism": { "const": null },
          "decision_receipt": { "const": null },
          "promotion_ready": { "const": false },
          "as_is_preservation_allowed": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "value_evidence_mode": { "const": "inherited" } } },
      "then": { "required": ["parent_application_id"] }
    },
    {
      "if": { "properties": { "value_evidence_mode": { "const": "enabler" } } },
      "then": { "required": ["enabler_kind"] }
    }
  ]
}
