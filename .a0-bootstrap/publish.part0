#!/usr/bin/env bash
set -euo pipefail
BASE_HEAD=4edc859861fba3f18fab0e65e9d2e8c0a7394bdb
TARGET_BRANCH=a0/free-page-state-coverage-r1-20260901
LANE1_BRANCH=a0/free-rows-data-r2-20260901
LANE2_BRANCH=a0/free-full-page-r2-20260901
LANE3_BRANCH=a0/tablet-review-delta-r1-20260901
PROD_HEAD=7b44306b0b58889506b987627fffb3848aa00ed6

python3 -m py_compile .a0-bootstrap-tools/finalize.py .a0-bootstrap-tools/verify_sources.py
rm -rf .a0-bootstrap-tools/__pycache__

for sha in \
  7bf067475a1dd03b5208b804ced9dbed277cdf30 \
  9b8043f3bdb86fab4eee00bf94b0f10d4f029c50 \
  663be702d481972cb2e8863af500f1c35dda1d8c \
  c2d6ff107c632311d1c1d0cb1b74d7eb0a465b18 \
  9342d785df1d583ac9104dff2253df0e05b687dd \
  8c7fcdb00f583b7de1849d9fa21542bc585f2cea; do
  git fetch --no-tags origin "$sha"
done
rm -rf /tmp/events-bot-new
git clone --no-checkout https://github.com/onedayonemasterpiece/events-bot-new.git /tmp/events-bot-new
git -C /tmp/events-bot-new fetch --no-tags origin "$PROD_HEAD"
EVENTS_REPO=/tmp/events-bot-new python3 .a0-bootstrap-tools/verify_sources.py

git config user.name 'a0-free-state-bot'
git config user.email 'a0-free-state-bot@users.noreply.github.com'

node --check scripts/asp-production-conveyor-v3/a0/free-rows-data-r2/free_rows_native_executor_r2.js
node --check scripts/asp-production-conveyor-v3/a0/free-rows-data-r2/setup_free_rows_data_r2.js
node --test tests/asp-production-conveyor-v3/a0/free-rows-data-r2/free_rows_data_r2.test.js
git rm -f .a0-bootstrap/payload.data.* .a0-bootstrap/publish.part* .github/workflows/a0-free-page-state-coverage-bootstrap.yml
git add \
  catalog/asp-production-conveyor-v3/a0/free-rows-data-r2 \
  scripts/asp-production-conveyor-v3/a0/free-rows-data-r2 \
  tests/asp-production-conveyor-v3/a0/free-rows-data-r2
git commit -m 'feat(a0): freeze A-FREE-ROWS-DATA-R2'
LANE1_HEAD=$(git rev-parse HEAD)
LANE1_TREE=$(git rev-parse HEAD^{tree})
git push origin "$LANE1_HEAD:refs/heads/$LANE1_BRANCH"

python3 .a0-bootstrap-tools/finalize.py lane2 "$LANE1_HEAD"
node --check scripts/asp-production-conveyor-v3/a0/free-full-page-r2/free_full_page_native_executor_r2.js
node --check scripts/asp-production-conveyor-v3/a0/free-full-page-r2/setup_free_full_page_r2.js
node --test tests/asp-production-conveyor-v3/a0/free-full-page-r2/free_full_page_r2.test.js
git add \
  catalog/asp-production-conveyor-v3/a0/free-full-page-r2 \
  scripts/asp-production-conveyor-v3/a0/free-full-page-r2 \
  tests/asp-production-conveyor-v3/a0/free-full-page-r2
git commit -m 'feat(a0): freeze A-FREE-FULL-PAGE-R2 ready and exception units'
LANE2_HEAD=$(git rev-parse HEAD)
LANE2_TREE=$(git rev-parse HEAD^{tree})
git push origin "$LANE2_HEAD:refs/heads/$LANE2_BRANCH"

node --check scripts/asp-production-conveyor-v3/a0/tablet-review-delta-r1/tablet_review_native_executor_r1.js
node --check scripts/asp-production-conveyor-v3/a0/tablet-review-delta-r1/setup_tablet_review_delta_r1.js
node --test tests/asp-production-conveyor-v3/a0/tablet-review-delta-r1/tablet_review