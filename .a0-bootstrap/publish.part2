n)"
cd /tmp/a0-final-readback
node --test \
  tests/asp-production-conveyor-v3/a0/free-rows-data-r2/free_rows_data_r2.test.js \
  tests/asp-production-conveyor-v3/a0/free-full-page-r2/free_full_page_r2.test.js \
