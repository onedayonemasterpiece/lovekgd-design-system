      "id": "shell.desktop-header",
      "source": "EventLayout.astro"
    },
    {
      "id": "shell.mobile-header",
      "source": "Reference4MobileMenu.astro"
    },
    {
      "id": "shell.mobile-menu",
      "source": "Reference4MobileMenu.astro"
    },
    {
      "id": "shell.mobile-bottom-navigation",
      "source": "MobileBottomNav.astro"
    },
    {
      "id": "shell.overlay-layer",
      "source": "EventLayout.astro + listing sheets/toasts"
    },
    {
      "id": "shell.footer",
      "source": "SiteFooter.astro"
    }
  ],
  "composition_rules": [
    "ready archetype instances use linked listing-card and mobile-rail resources",
    "desktop ready flow is one centered chronological column: each time-group header is co-located with its linked ListingEventCard slot; cards are never regrouped into a visual grid",
    "state surfaces are semantic states, not hidden terminal overrides",
    "mobile date accessory is a linked fixed-position listing component above the linked shell bottom navigation; its date chips and calendar trigger remain linked semantic actions",
    "shell overlay owns stacking and safe-area offsets",
    "desktop and mobile are separate parent contexts at 759/720 boundaries",
    "sparse desktop is a bounded linked archetype variant: one specific-date header, one time-group header, one linked compact listing card, and one semantic Like-with-count proof; review boards only instantiate the archetype",
    "stress proof is a bounded viewport component, not a long review page; its metadata owns the complete six-fixture registry while the viewport renders only chronologically visible fixtures"
  ],
  "archetype_variants": [
    {
      "id": "archetype.listing.date.today",
      "view": "today",
      "density": [
        "regular",
        "stress"
      ]
    },
    {
      "id": "archetype.listing.date.tomorrow",
