{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kenigevents.asp-conveyor.a0.candidate-adapter.schema.v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_manifest": {
      "type": "object",
      "required": [
        "package_id",
        "owner",
        "priority",
        "status",
        "branch",
        "sha",
        "paths",
        "source_and_donor_lineage",
        "corpus_projection_state_tuple",
        "archetype_or_route_ids",
        "dependencies",
        "target_penpot_page",
        "expected_roots",
        "expected_components",
        "expected_instances",
        "materialization_entry_point",
        "validation",
        "astro_evidence_cases",
        "explicit_gaps",
        "package_record_sha256"
      ],
      "properties": {
        "owner": {
          "const": "A0"
        },
        "status": {
          "const": "READY_TO_PUBLISH"
        },
        "branch": {
          "const": "a0/asp-production-conveyor-20260831"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "package_record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    },
    "build_step": {
      "type": "object",
      "required": [
        "order",
        "semantic_root_key",
        "scenario_id",
        "viewport",
        "projection_ref",
        "projection_sha256",
        "fixture_ids",
        "fixture_semantics",
        "required_states",
        "active_candidate_state",
        "shell_semantic_slots",
        "component_semantic_refs",
        "expected_instances",
        "geometry_authority"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_root_key": {
          "type": "string",
          "pattern": "^a0\\.candidate\\.root\\."
        },
        "scenario_id": {
          "type": "string"
        },
        "viewport": {
          "type": "object",
          "required": [
            "id",
            "width"
          ],
          "properties": {
            "id": {
              "enum": [
                "desktop",
                "mobile"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "projection_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^event\\.real\\.[0-9]+$"
          }
        },
        "required_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "shell_semantic_slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "component_semantic_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected_instances": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "candidate_adapter": {
      "type": "object",
      "required": [
        "schema_version",
        "adapter_id",
        "package_manifest",
        "materialization_status",
        "acceptance_status",
        "visual_acceptance",
        "promotion_authorized",
        "penpot_mutations",
        "canonicalization",
        "source_inputs",
        "dependency_refs",
        "target",
        "bounded_mutation_scope",
        "build_contract",
        "readback_contract",
        "abort_conditions",
        "idempotency",
        "receipts"
      ],
      "properties": {
        "schema_version": {
          "const": "kenigevents.asp-conveyor.a0.candidate-adapter.v1"
        },
        "package_manifest": {
          "$ref": "#/$defs/package_manifest"
        },
        "materialization_status": {
          "const": "READY_TO_MATERIALIZE_CANDIDATE"
        },
        "acceptance_status": {
          "const": "CANDIDATE_BUILD_NOT_ACCEPTED"
        },
        "visual_acceptance": {
          "const": "PENDING_V0"
        },
        "promotion_authorized": {
          "const": false
        },
        "penpot_mutations": {
          "const": 0
        },
        "build_contract": {
          "type": "object",
          "required": [
            "ordering",
            "steps"
          ],
          "properties": {
            "ordering": {
              "const": "STRICT_ASCENDING_ORDER"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/build_step"
              }
            }
          }
        },
        "receipts": {
          "type": "object",
          "required": [
            "receipt_path",
            "adapter_record_sha256"
          ],
          "properties": {
            "adapter_record_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "queue": {
      "type": "object",
      "required": [
        "schema_version",
        "ready",
        "preparing",
        "rules",
        "queue_record_sha256"
      ],
      "properties": {
        "ready": {
          "type": "array",
          "minItems": 1
        },
        "preparing": {
          "type": "array",
          "minItems": 1
        },
        "queue_record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "canonicalization",
        "files",
        "record_hashes",
        "receipt_record_sha256"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 3
        },
        "receipt_record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    }
  }
}
