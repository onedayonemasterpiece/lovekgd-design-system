{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kenigevents.asp-penpot-page-wave-unit.v1",
  "type": "object",
  "required": [
    "schema_version",
    "unit_id",
    "package_id",
    "state",
    "source_adapter",
    "page_contract",
    "limits",
    "artifacts",
    "protected_projections",
    "dependencies",
    "visual_acceptance",
    "promotion_authorized",
    "package_record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "kenigevents.asp-penpot-page-wave-unit.v1"
    },
    "state": {
      "const": "MAT_PACKAGE_READY_QA_INTEGRATE_GATED"
    },
    "penpot_execution_authorized": {
      "const": false
    },
    "visual_acceptance": {
      "const": "PENDING_V0"
    },
    "promotion_authorized": {
      "const": false
    },
    "page_contract": {
      "type": "object",
      "required": [
        "page_name",
        "candidate_roots",
        "desktop_mobile_side_by_side",
        "variants"
      ],
      "properties": {
        "candidate_roots": {
          "const": 1
        },
        "desktop_mobile_side_by_side": {
          "const": true
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "component_families": {
          "type": "integer",
          "maximum": 3
        },
        "managed_nodes": {
          "type": "integer",
          "maximum": 30
        },
        "max_managed_creations_per_invocation": {
          "const": 3
        },
        "executor_bytes": {
          "type": "integer",
          "maximum": 65000
        }
      }
    }
  }
}
